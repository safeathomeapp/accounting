# Environment Configuration Template
# Multi-Platform AI Practice Management System
#
# INSTRUCTIONS:
# 1. Copy this file to .env (cp .env.example .env)
# 2. Fill in your actual values
# 3. NEVER commit .env to git
#
# Last Updated: November 22, 2025

# ============================================
# APPLICATION SETTINGS
# ============================================

# Environment: development | staging | production
ENVIRONMENT=development

# Application
APP_NAME="Multi-Platform AI Practice Management"
APP_VERSION=2.0.0-alpha
DEBUG=True

# Server
HOST=localhost
PORT=8000
RELOAD=True

# ============================================
# DATABASE (PostgreSQL)
# ============================================

# PostgreSQL Connection
DATABASE_URL=postgresql://username:password@localhost:5432/practice_dev

# Alternative format (if needed)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=practice_dev
DB_USER=your_username
DB_PASSWORD=your_password

# Database Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ============================================
# CLAUDE API (Anthropic)
# ============================================

# Get from: https://console.anthropic.com
CLAUDE_API_KEY=sk-ant-api03-your-key-here

# Model Selection
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_MAX_TOKENS=4096

# Cost Management
CLAUDE_MONTHLY_BUDGET_GBP=30.00
CLAUDE_ALERT_THRESHOLD_GBP=25.00

# ============================================
# XERO API
# ============================================

# Get from: https://developer.xero.com/app/manage
XERO_CLIENT_ID=your-xero-client-id-here
XERO_CLIENT_SECRET=your-xero-client-secret-here

# OAuth Settings
XERO_REDIRECT_URI=http://localhost:8000/auth/xero/callback
XERO_SCOPE=offline_access accounting.transactions accounting.contacts accounting.settings

# Tenant/Organization (set after first OAuth)
XERO_TENANT_ID=

# ============================================
# QUICKBOOKS API
# ============================================

# Get from: https://developer.intuit.com
QB_CLIENT_ID=your-quickbooks-client-id-here
QB_CLIENT_SECRET=your-quickbooks-client-secret-here

# OAuth Settings
QB_REDIRECT_URI=http://localhost:8000/auth/quickbooks/callback
QB_ENVIRONMENT=sandbox
# Change to 'production' when ready

# Company ID (set after first OAuth)
QB_COMPANY_ID=

# ============================================
# SECURITY
# ============================================

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here-generate-a-random-one

# JWT Settings
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Encryption Key (for storing credentials)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-encryption-key-here

# ============================================
# LOGGING
# ============================================

LOG_LEVEL=INFO
# Options: DEBUG | INFO | WARNING | ERROR | CRITICAL

LOG_FILE=logs/app.log
LOG_MAX_BYTES=10485760
# 10MB

LOG_BACKUP_COUNT=5

# ============================================
# API RATE LIMITING
# ============================================

# Requests per minute
RATE_LIMIT_PER_MINUTE=60

# Claude API specific
CLAUDE_RATE_LIMIT_PER_MINUTE=50

# Xero API specific
XERO_RATE_LIMIT_PER_MINUTE=60

# QuickBooks API specific
QB_RATE_LIMIT_PER_MINUTE=100

# ============================================
# CACHING
# ============================================

# Cache Settings
CACHE_ENABLED=True
CACHE_TTL_SECONDS=3600
# 1 hour

# Redis (if using for caching - optional)
# REDIS_URL=redis://localhost:6379/0

# ============================================
# FRONTEND (Phase 3+)
# ============================================

# API Base URL (for frontend)
API_BASE_URL=http://localhost:8000

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ============================================
# TESTING
# ============================================

# Test Database
TEST_DATABASE_URL=postgresql://username:password@localhost:5432/practice_test

# Mock API Keys (for testing)
TEST_CLAUDE_API_KEY=test-key
TEST_XERO_CLIENT_ID=test-xero
TEST_QB_CLIENT_ID=test-qb

# ============================================
# DEVELOPMENT TOOLS
# ============================================

# Auto-reload on code changes
AUTO_RELOAD=True

# Show SQL queries in logs
ECHO_SQL=False

# Pretty print JSON responses
PRETTY_JSON=True

# ============================================
# MONITORING & ALERTS
# ============================================

# Email alerts (optional)
ALERT_EMAIL=your-email@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-specific-password

# Slack webhooks (optional)
SLACK_WEBHOOK_URL=

# ============================================
# BUSINESS LOGIC
# ============================================

# Default Platform
DEFAULT_ACCOUNTING_PLATFORM=xero

# Supported Platforms (comma-separated)
SUPPORTED_PLATFORMS=xero,quickbooks

# Auto-sync interval (minutes)
AUTO_SYNC_INTERVAL=60

# Transaction batch size
TRANSACTION_BATCH_SIZE=50

# ============================================
# AI BEHAVIOR
# ============================================

# Confidence thresholds
AI_HIGH_CONFIDENCE_THRESHOLD=0.90
AI_MEDIUM_CONFIDENCE_THRESHOLD=0.70
AI_LOW_CONFIDENCE_THRESHOLD=0.50

# Auto-categorize if confidence above this
AUTO_CATEGORIZE_THRESHOLD=0.85

# Knowledge base path
KNOWLEDGE_BASE_PATH=./knowledge-base

# ============================================
# FEATURE FLAGS
# ============================================

# Enable/disable features
FEATURE_XERO_ENABLED=True
FEATURE_QUICKBOOKS_ENABLED=False
# Set to True in Month 7+

FEATURE_AI_ANALYSIS_ENABLED=True
FEATURE_EMAIL_GENERATION_ENABLED=True
FEATURE_AUTO_SYNC_ENABLED=False
# Enable when ready

# ============================================
# TIMEZONE & LOCALE
# ============================================

TIMEZONE=Europe/London
LOCALE=en_GB
CURRENCY=GBP

# ============================================
# NOTES
# ============================================

# Remember to:
# 1. Never commit this file with real values
# 2. Keep .env.example updated with new variables
# 3. Document any new environment variables
# 4. Use strong secrets for production
# 5. Rotate keys regularly
#
# Security best practices:
# - Use different keys for development/production
# - Store production keys in secure vault
# - Enable 2FA on all API accounts
# - Monitor API usage for anomalies
# - Review and revoke unused API keys
#
# For help: See docs/SETUP_GUIDE.md
