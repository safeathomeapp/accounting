# Environment Configuration - LOCATION 2
# Use this when working from: [Your Location 2 Address/Name]
# IP Address: 192.168.0.37

# Backend API Configuration
# This points to your backend at Location 2
API_BASE_URL=http://192.168.0.37:8000/api/mobile

# App Environment
ENVIRONMENT=development

# Debug Mode
# Set to true to see extra logging and debug messages
DEBUG=true

# Timeout Settings (in milliseconds)
# How long to wait before giving up on API requests
API_TIMEOUT=30000

# Feature Flags
# Enable/disable features during development
ENABLE_OFFLINE_SYNC=true
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_ANALYTICS=false
