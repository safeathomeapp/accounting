{
  "name": "accountancy-mobile",
  "version": "0.1.0",
  "description": "Mobile app for Xero/QuickBooks accounting sync platform built with React Native and Expo",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "prebuild": "expo prebuild --clean",
    "build-android": "eas build --platform android",
    "build-ios": "eas build --platform ios"
  },
  "dependencies": {
