# Accountancy Mobile App Environment Configuration
#
# IMPORTANT: This is a template! Do NOT use this file directly!
#
# Instead, use one of these options:
#
# OPTION 1 (Recommended): Multiple Locations
# If you work from multiple locations with different IPs:
#   - Edit .env.location1 and .env.location2 with your IPs
#   - Use switch-location.bat (Windows) or switch-location.sh (Mac/Linux)
#   - See LOCATION_SWITCHING_GUIDE.md for details
#
# OPTION 2: Single Location
# If you only work from one location:
#   - Copy this file to .env.local
#   - Fill in API_BASE_URL below
#
# IMPORTANT: .env.local is NEVER committed to git - it's in .gitignore!

# Backend API Configuration
# This is the URL where your backend is running
# For local development: http://YOUR_COMPUTER_IP:8000
# For production: https://api.example.com
#
# Examples:
#   Local (same computer): http://localhost:8000/api/mobile
#   Remote (same network): http://192.168.1.143:8000/api/mobile
API_BASE_URL=http://localhost:8000/api/mobile

# App Environment
# Values: development, staging, production
ENVIRONMENT=development

# Debug Mode
# Set to true to see extra logging and debug messages
DEBUG=true

# Timeout Settings (in milliseconds)
# How long to wait before giving up on API requests
API_TIMEOUT=30000

# Feature Flags
# Enable/disable features during development
ENABLE_OFFLINE_SYNC=true
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_ANALYTICS=false

# Expo Configuration
# Don't edit these - they're set automatically by Expo
EXPO_PROJECT_ID=your-expo-project-id
