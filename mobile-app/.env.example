# Accountancy Mobile App Environment Configuration
#
# Copy this file to .env.local and fill in your values
# IMPORTANT: Never commit .env.local to git - it's in .gitignore
#
# These values configure how the mobile app connects to the backend

# Backend API Configuration
# This is the URL where your backend is running
# For local development: http://YOUR_COMPUTER_IP:8000
# For production: https://api.example.com
API_BASE_URL=http://localhost:8000/api/mobile

# App Environment
# Values: development, staging, production
ENVIRONMENT=development

# Debug Mode
# Set to true to see extra logging and debug messages
DEBUG=true

# Timeout Settings (in milliseconds)
# How long to wait before giving up on API requests
API_TIMEOUT=30000

# Feature Flags
# Enable/disable features during development
ENABLE_OFFLINE_SYNC=true
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_ANALYTICS=false

# Expo Configuration
# Don't edit these - they're set automatically by Expo
EXPO_PROJECT_ID=your-expo-project-id
